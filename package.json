{
  "name": "movieflix",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npx concurrently \"npm run dev --workspace=@movieflix/frontend\" \"npm run dev --workspace=@movieflix/backend\"",
    "dev:backend": "npm run dev --workspace=@movieflix/backend",
    "dev:frontend": "npm run dev --workspace=@movieflix/frontend",
    "build:backend": "npm run build --workspace=@movieflix/backend",
    "build:frontend": "npm run build --workspace=@movieflix/frontend",
    "start:backend": "npm start --workspace=@movieflix/backend",
    "start:frontend": "npm run dev --workspace=@movieflix/frontend",
    "migrate:backend": "npx --workspace=@movieflix/backend prisma migrate dev",
    "prisma:generate": "npm run prisma:generate --workspace=@movieflix/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@movieflix/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  }
}
