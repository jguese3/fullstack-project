// Prisma schema for MovieFlex — Sprint 5
//
// Migration 1 (add-user-table):
//   Added User model to track application users by their Clerk ID.
//   The database does NOT authenticate — Clerk handles that.
//   clerkId is the bridge between our DB and Clerk's auth system.
//
// Migration 2 (add-user-to-watchlist-and-reviews):
//   Added userId FK to WatchlistEntry and Review so data is per-user.
//   @@unique([movieId, userId]) replaces @@unique([movieId]) — the same
//   movie can now be in multiple users' watchlists.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Migration 1: User ─────────────────────────────────────────────────────────
model User {
  id          Int              @id @default(autoincrement())
  clerkId     String           @unique  // Clerk's user ID — used to look up our user
  email       String           @unique
  displayName String?
  createdAt   DateTime         @default(now())

  watchlistEntries WatchlistEntry[]
  reviews          Review[]
}

// ── Movie (unchanged) ─────────────────────────────────────────────────────────
model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  year        Int
  genre       String
  director    String
  rating      Float
  description String
  poster      String

  watchlistEntries WatchlistEntry[]
  reviews          Review[]
}

// ── Migration 2: WatchlistEntry now includes userId ───────────────────────────
model WatchlistEntry {
  id      Int      @id @default(autoincrement())
  userId  Int
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId Int
  movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())
  watched Boolean  @default(false)

  // Each user can only add the same movie to their watchlist once
  @@unique([userId, movieId])
}

// ── Migration 2: Review now includes userId ───────────────────────────────────
model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId   Int
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  text      String
  rating    Int
  createdAt DateTime @default(now())
}
