{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist",
    "baseUrl": "./",
    "sourceMap": true,
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "*": ["*"]
    }
  },
  "include": [
    "app.ts",
    "server.ts",
    "controllers/**/*",
    "routes/**/*",
    "services/**/*",
    "validation/**/*",
    "prisma/**/*",
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
