generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Catalogue movies used by All Movies (Jarone)
model Movies {
  id          Int     @id @default(autoincrement())
  title       String
  description String
  releaseDate String
  rating      Float
  watchlist   Boolean @default(false)
  isWatched   Boolean @default(false)
}

/// Personal collection movies used by My Movies (Navpreet)
model Movie {
  id     Int    @id @default(autoincrement())
  title  String
  genre  String
  status String
}
