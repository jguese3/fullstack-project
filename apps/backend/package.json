{
  "name": "@movieflix/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc --project tsconfig.json --noEmit false",
    "start": "node dist/server.js",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "vercel-build": "prisma migrate deploy && prisma db seed && npm run build",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/express": "^2.1.50",
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "joi": "^18.2.3",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2"
  }
}
